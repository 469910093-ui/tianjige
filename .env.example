# 天机阁 / 今天吃什么 · 本地环境变量示例
# 复制为 .env.local 后填写真实 Key（不要提交密钥）

# DeepSeek（报告生成）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 百度地图 Agent Plan SK（baidu-ai-map skill，推荐；Bearer 鉴权）
# 申请：https://lbs.baidu.com/apiconsole/agentplan
BAIDU_MAP_AUTH_TOKEN=

# 备选：百度地点检索 AK（传统 Place v2）
# 申请：https://lbsyun.baidu.com/ → 应用管理 → 创建应用 → 启用「地点检索」
BAIDU_MAP_AK=

# 备选：腾讯位置服务（标准地点搜索无评分字段）
# 申请：https://lbs.qq.com/ → 控制台 → Key 管理 → 启用 WebServiceAPI
TENCENT_MAP_KEY=
